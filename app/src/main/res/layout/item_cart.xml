<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="🎨"
            android:textSize="28sp"
            android:background="@color/brown_50"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cart_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Producto"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brown_900"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_cart_precio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="13sp"
                android:textColor="@color/amber_700"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_cart_subtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtotal: $0.00"
                android:textSize="12sp"
                android:textColor="@color/brown_500"
                android:layout_marginTop="2dp" />

            <!-- Controles de cantidad -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageButton
                    android:id="@+id/btn_cart_minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/btn_minus"
                    android:background="@color/brown_100"
                    android:contentDescription="Menos" />

                <TextView
                    android:id="@+id/tv_cart_cantidad"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/brown_900" />

                <ImageButton
                    android:id="@+id/btn_cart_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/btn_plus"
                    android:background="@color/brown_100"
                    android:contentDescription="Más" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_cart_remove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/error_red"
            android:contentDescription="Eliminar" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
